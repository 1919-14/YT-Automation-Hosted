# ============================================================
# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real keys.
# ============================================================

# --- LLM (script generation) ---
# OpenCode Zen — OpenAI-compatible endpoint
LLM_PROVIDER=opencode_zen
LLM_BASE_URL=https://opencode.ai/zen/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=deepseek-v4-flash-free

# --- YouTube Data API v3 ---
YT_CLIENT_SECRETS_FILE=data/yt_client_secret.json
YT_TOKEN_FILE=data/yt_token.json

# --- Pexels (stock visuals, style B) ---
PEXELS_API_KEY=

# --- Telegram Bot (remote control & status alerts) ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_numeric_telegram_user_id

# --- Local model paths / settings ---
SD_MODEL=sdxl-turbo
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cuda
